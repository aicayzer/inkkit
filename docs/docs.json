{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Inkkit",
  "colors": {
    "primary": "#505050",
    "light": "#D4D4D4",
    "dark": "#404040"
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting started",
        "pages": ["index"]
      }
    ]
  },
  "navbar": {
