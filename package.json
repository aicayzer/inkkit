{
  "name": "@aicayzer/inkkit",
  "version": "0.4.1",
  "description": "A preserving Markdown editor for offline web views and the web",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aicayzer/inkkit.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./style.css": "./dist/style.css"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/index.js",
    "./dist/chunks/*.js",
    "./src/index.ts"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.build.json && vite build --config vite.package.config.ts && node scripts/build-host-notices.ts && node scripts/finish-build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "vite playground",
    "build:playground": "vite build playground --config vite.config.ts",
    "test:docs": "node --test scripts/api-docs/*.test.mjs && node scripts/check-api-docs.mjs",
    "test:package": "node scripts/test-package.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm test:docs && pnpm test:package",
    "test:browser": "playwright test --project=chromium",
    "test:built-playground": "playwright test --config playwright.built.config.ts"
  },
  "devDependencies": {
    "@milkdown/kit": "7.22.3",
    "@playwright/test": "^1.64.0",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.2",
    "axe-core": "^4.14.0",
    "dompurify": "3.4.17",
    "jsdom": "^30.1.0",
    "lowlight": "^3.3.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm-autolink-literal": "^2.0.1",
    "mdast-util-gfm-footnote": "^2.1.0",
    "mdast-util-gfm-strikethrough": "^2.0.0",
    "mdast-util-gfm-table": "^2.0.0",
    "mdast-util-gfm-task-list-item": "^2.0.0",
    "mdast-util-highlight-mark": "1.2.2",
    "mdast-util-mdx": "3.0.0",
    "mdast-util-to-markdown": "2.2.0",
    "micromark-extension-gfm-autolink-literal": "^2.1.0",
    "micromark-extension-gfm-footnote": "^2.1.0",
    "micromark-extension-gfm-strikethrough": "^2.1.0",
    "micromark-extension-gfm-table": "^2.1.1",
    "micromark-extension-gfm-task-list-item": "^2.1.0",
    "micromark-extension-highlight-mark": "1.2.0",
    "micromark-extension-mdxjs": "3.0.0",
    "micromark-util-normalize-identifier": "^2.0.1",
    "micromark-util-types": "^2.0.3",
    "pele": "1.12.0",
    "prettier": "^3.9.8",
    "prosemirror-drop-indicator": "0.1.4",
    "prosemirror-search": "^1.1.1",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.1"
  }
}
